# ── Required ─────────────────────────────────────────────────────────────
# One Groq key is enough. Several keys are rotated round-robin (a key that hits
# a rate limit sits out while the others keep serving). Any of these forms work:
GROQ_API_KEY=gsk_your_key_here
# GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEYS=gsk_a,gsk_b,gsk_c

# ── Optional ─────────────────────────────────────────────────────────────
# GROQ_STT_MODEL=whisper-large-v3              # final (accurate) text
# GROQ_STT_FAST_MODEL=whisper-large-v3-turbo   # text shown first, corrected by the final
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# STT_LANGUAGE=auto          # default when the browser doesn't choose: auto | en | hi
# STT_EXPECTED_LANGUAGES=en,hi   # auto-detections outside these are re-checked
# STT_CONCURRENCY=4          # utterances transcribed in parallel per session
# GROQ_RPM_PER_KEY=20        # Groq requests/minute per model per key (raise on paid tiers)
# ALLOWED_ORIGINS=           # extra origins allowed to call the API (comma-separated)
